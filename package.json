{
  "name": "neu-dot",
  "productName": "NEU Dot",
  "version": "0.7.8",
  "private": true,
  "description": "东北大学学生的本地校园个人助手：课表、待办、笔记、邮件与 AI 工作台",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts/build-website.mjs docs README.md *.json electron.vite.config.ts",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "6.8.11",
    "fflate": "^0.8.3",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "openai": "7.47.0",
    "pdfjs-dist": "6.5.438",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.2.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "6.0.0",
    "lucide-react": "^1.0.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "cn.neu.dola",
    "productName": "NEU Dot",
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "scripts/mac-update-helper.sh",
        "to": "mac-update-helper.sh"
      }
    ],
    "directories": {
      "output": "assets/output/releases"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "NEU-Dot-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "yzbcs",
        "repo": "NEU-Dot",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzbcs/NEU-Dot.git"
  },
  "homepage": "https://github.com/yzbcs/NEU-Dot#readme",
  "bugs": {
    "url": "https://github.com/yzbcs/NEU-Dot/issues"
  }
}
